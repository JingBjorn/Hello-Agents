# Tavily API Key
export TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# Hugging Face API Token
HF_TOKEN=YOUR_HF_TOKEN

# 大语言模型 API 配置（选择其中一种）
# 选项一：AIHubmix
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# OPENAI_BASE_URL=https://aihubmix.com/v1
# OPENAI_MODEL_NAME=coding-glm-5.1-free

# 选项二：Modelscope
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1/
OPENAI_MODEL_NAME=deepseek-ai/DeepSeek-V4.1-Flash

LLM_TIMEOUT=60

# chapter4 客户端模式：openai（上述供应商）或 local_runtime（本地 Runtime 中转）
LLM_BACKEND=local_runtime
# 填根地址即可；本机 Runtime 负责认证，无需在客户端另填 API Key。
LOCAL_RUNTIME_BASE_URL=http://127.0.0.1:38471
# 使用本地 Runtime 的 /v1/models 返回的完整模型 ID。
LOCAL_RUNTIME_MODEL_NAME=YOUR_RUNTIME_MODEL_ID
LOCAL_RUNTIME_MAX_OUTPUT_TOKENS=2048
